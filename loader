-- ============================
-- REMOTE EVENT HELPER
-- ============================
local function getToServerEvent()
    local events = ReplicatedStorage:FindFirstChild("Events")
    if events then
        return events:FindFirstChild("To_Server")
    end
    return nil
end

local function fireToServer(args)
    local ev = getToServerEvent()
    if not ev then
        warn("[AutoFarm] RemoteEvent 'To_Server' não encontrado!")
        return false
    end
    pcall(function()
        ev:FireServer(unpack(args))
    end)
    return true
end

