local function startQuest(id)
    State.CurrentQuest = id
    local qnum = id:gsub("Q","")
    task.spawn(function()
        while State.CurrentQuest == id do
            fireToServer({{["Id"]=qnum,["Type"]="Accept",["Action"]="_Quest"}})
            task.wait(1)
        end
    end)
end

