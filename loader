local function inspectFirstMob()
    for _, d in ipairs(Workspace:GetDescendants()) do
        if isAliveMob(d) then
            local lines = {}
            table.insert(lines, "Model.Name: " .. d.Name)
            table.insert(lines, "ClassName: " .. d.ClassName)
            table.insert(lines, "--- Atributos ---")
            local attrs = d:GetAttributes()
            if #attrs == 0 then
                table.insert(lines, "(nenhum)")
            else
                for _, attr in ipairs(attrs) do
                    table.insert(lines, attr .. " = " .. tostring(d:GetAttribute(attr)))
                end
            end
            table.insert(lines, "--- Filhos ---")
            for _, c in ipairs(d:GetChildren()) do
                local val = ""
                if c:IsA("StringValue") then val = " = \"" .. c.Value .. "\""
                elseif c:IsA("NumberValue") or c:IsA("IntValue") then val = " = " .. c.Value
                elseif c:IsA("BoolValue") then val = " = " .. tostring(c.Value)
                end
                table.insert(lines, c.ClassName .. ": " .. c.Name .. val)
            end
            table.insert(lines, "--- Humanoid ---")
            local hum = d:FindFirstChildOfClass("Humanoid")
            if hum then
                table.insert(lines, "DisplayName: " .. hum.DisplayName)
                table.insert(lines, "Health: " .. hum.Health .. "/" .. hum.MaxHealth)
            end
            inspectBox.Text = table.concat(lines, "\n")
            setStatus("Inspeção na UI ✓")
            print("========== INSPEÇÃO DE MOB ==========")
            for _, l in ipairs(lines) do print(l) end
            print("=====================================")
            return
        end
    end
    inspectBox.Text = "Nenhum mob encontrado pra inspecionar."
end

