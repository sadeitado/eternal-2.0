makeSection("AUTO FARM")

makeButton("🔍 Escanear Mobs (imprime no F9)", function()
    setStatus("Escaneando...")
    local list, total = scanMobs()
    if total == 0 then
        setStatus("Nenhum mob encontrado")
        return
    end
    local names = {}
    for _, d in ipairs(list) do table.insert(names, d.name) end
    Config.SelectedMob = names[1]
    setStatus("1º mob: " .. names[1] .. " | Total: " .. total)
end)

makeButton("🎯 Trocar Mob Alvo", function()
    if not Config.SelectedMob then
        setStatus("Escaneie primeiro")
        return
    end
    local names = {}
    for n, _ in pairs(State.MobCache) do table.insert(names, n) end
    table.sort(names)
    local idx = 1
    for i, n in ipairs(names) do
        if n == Config.SelectedMob then idx = i % #names + 1 break end
    end
    Config.SelectedMob = names[idx]
    setStatus("Alvo: " .. Config.SelectedMob .. " (" .. State.MobCache[Config.SelectedMob].count .. "x)")
end)

makeToggle("⚔️ Ativar Auto Farm", false, function(state)
    if state and not Config.SelectedMob then
        setStatus("Escaneie mobs primeiro!")
        -- Desmarca o toggle
        return
    end
    Config.AutoFarm = state
    if state then
        setStatus("Farm ativo: " .. Config.SelectedMob)
        if not State.AutoFarmThread then
            State.AutoFarmThread = task.spawn(autoFarmLoop)
        end
    else
        setStatus("Farm desativado")
    end
end)

