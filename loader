-- ============================
-- EXTRAÇÃO
-- ============================
local function extractRank(mob)
    for _, attr in ipairs(mob:GetAttributes()) do
        local val = mob:GetAttribute(attr)
        if type(val) == "string" and RANK_ORDER[val:upper()] then return val:upper() end
        if attr:lower():find("rank") or attr:lower():find("tier") then
            if type(val) == "string" then return val:upper() end
        end
    end
    for _, child in ipairs(mob:GetChildren()) do
        local cn = child.Name:lower()
        if (cn:find("rank") or cn:find("tier")) and child:IsA("StringValue") then
            local v = child.Value:upper()
            if RANK_ORDER[v] then return v end
        end
    end
    for _, child in ipairs(mob:GetChildren()) do
        if child:IsA("StringValue") then
            local v = child.Value:upper()
            if RANK_ORDER[v] then return v end
        end
    end
    local fromName = mob.Name:match("%(([EDCBAS]+)%)") or mob.Name:match("[%s_%-]([EDCBAS]+)$")
    if fromName then
        local up = fromName:upper()
        if RANK_ORDER[up] then return up end
    end
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if hum and hum.DisplayName then
        local m = hum.DisplayName:match("%(([EDCBAS]+)%)") or hum.DisplayName:match("[%s_%-]([EDCBAS]+)$")
        if m and RANK_ORDER[m:upper()] then return m:upper() end
    end
    return "?"
end

local function extractName(mob)
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if hum and hum.DisplayName and hum.DisplayName ~= "" then
        local clean = hum.DisplayName:gsub("%s*%([EDCBAS]+%)", ""):gsub("[%s_%-][EDCBAS]+$", ""):gsub("^[EDCBAS]+[%s_%-]", "")
        clean = clean:gsub("^%s+", ""):gsub("%s+$", "")
        if #clean > 0 then return clean end
    end
    for _, child in ipairs(mob:GetChildren()) do
        if child:IsA("StringValue") then
            local cn = child.Name:lower()
            if (cn == "name" or cn == "mobname" or cn:find("displayname")) and child.Value ~= "" then
                return child.Value
            end
        end
    end
    local n = mob.Name:gsub("%s*%(%d+%)$", ""):gsub("%s*%([EDCBAS]+%)$", ""):gsub("[%s_%-][EDCBAS]+$", "")
    return n
end

-- ============================
-- DETECÇÃO
-- ============================
local function isAliveMob(instance)
    if not instance or not instance.Parent then return false end
    if not instance:IsA("Model") then return false end
    local humanoid = instance:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if instance == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(instance) then return false end
    return true, humanoid
end

local function scanMobs()
    print("[AutoFarm] Escaneando...")
    local t0 = tick()
    local mobTypes = {}
    local totalFound = 0
    local count = 0
    for _, d in ipairs(Workspace:GetDescendants()) do
        count = count + 1
        if count % 500 == 0 then task.wait() end
        if isAliveMob(d) then
            totalFound = totalFound + 1
            local name = extractName(d)
            local rank = extractRank(d)
            local key = name .. " [" .. rank .. "]"
            if not mobTypes[key] then
                mobTypes[key] = { name = name, rank = rank, key = key, count = 0, examples = {} }
            end
            mobTypes[key].count = mobTypes[key].count + 1
            table.insert(mobTypes[key].examples, d)
        end
    end
    local list = {}
    for _, data in pairs(mobTypes) do table.insert(list, data) end
    table.sort(list, function(a,b)
        local ra = RANK_ORDER[a.rank] or 99
        local rb = RANK_ORDER[b.rank] or 99
        if ra ~= rb then return ra < rb end
        return a.name < b.name
    end)
    State.MobCache = mobTypes
    State.MobList = list
    local elapsed = math.floor((tick() - t0) * 100) / 100
    print("[AutoFarm] Scan OK: " .. totalFound .. " mobs, " .. #list .. " tipos (" .. elapsed .. "s)")
    for _, d in ipairs(list) do
        print("  - [" .. d.rank .. "] " .. d.name .. " (" .. d.count .. "x)")
    end
    return list, totalFound
end

-- ============================
-- ATAQUE
-- ============================
local function attackMob(mob, humanoid)
    if not mob or not mob.PrimaryPart or not humanoid then return end
    if humanoid.Health <= 0 then return end
    local now = tick()
    if now - State.LastAttack < Config.AttackCooldown then return end
    State.LastAttack = now
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
    if tool then pcall(function() tool:Activate() end) end
    pcall(function()
        VirtualUser:Button1Down(Vector2.new(0,0))
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(0,0))
    end)
end

-- ============================
-- AUTO FARM LOOP
-- ============================
local function autoFarmLoop()
    print("[AutoFarm] Loop iniciado: " .. tostring(Config.SelectedMob))
    while Config.AutoFarm do
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            task.wait(0.5) continue
        end
        local myRoot = char.HumanoidRootPart
        local mobData = State.MobCache[Config.SelectedMob]
        if not mobData then task.wait(0.5) continue end

        local closestMob, closestDist, closestHumanoid = nil, math.huge, nil
        for _, mob in ipairs(mobData.examples) do
            if mob.Parent and isAliveMob(mob) and mob.PrimaryPart then
                local dist = (myRoot.Position - mob.PrimaryPart.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestMob = mob
                    closestHumanoid = mob:FindFirstChildOfClass("Humanoid")
                end
            end
        end
        if closestMob then
            local mobPos = closestMob.PrimaryPart.Position
            local dir = (myRoot.Position - mobPos).Unit
            local targetPos = mobPos + dir * Config.TeleportDistance
            targetPos = Vector3.new(targetPos.X, mobPos.Y + 3, targetPos.Z)
            myRoot.CFrame = CFrame.new(targetPos)
            attackMob(closestMob, closestHumanoid)
        end
        task.wait(0.1)
    end
    print("[AutoFarm] Loop encerrado")
end

