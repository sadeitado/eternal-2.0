-- PASTA DE MOBS
-- ============================
local function getMobFolder()
    local debris = Workspace:FindFirstChild("Debris")
    if debris then
        local m = debris:FindFirstChild("Monsters")
        if m then return m end
    end
    for _, name in ipairs({"Monsters","Mobs","Enemies"}) do
        local f = Workspace:FindFirstChild(name)
        if f then return f end
    end
    return nil
end

-- ============================
-- UTILS
-- ============================
local function looksLikeId(s)
    if #s < 20 then return false end
    local numeric = 0
    for i = 1, #s do
        local c = s:sub(i,i)
        if c:match("%d") or c == "-" then numeric = numeric + 1 end
    end
    return (numeric / #s) > 0.4
end

-- Extrai o "tipo" do mob: se for ID tipo "0a75-2e1c84a1a75df17...", pega o prefixo antes do hífen
-- Se não, retorna o nome normal
local function extractType(mob)
    local name = mob.Name
    -- Formato: "XXXX-XXXXXXXXXXXXXXXXXXXXXXXX"
    local prefix = name:match("^(%x+)%-%x+$")
    if prefix then
        return prefix:upper()  -- ex: "0A75"
    end
    -- Formato com espaço: "0a75 2e1c..."
    prefix = name:match("^(%x+)%s")
    if prefix then return prefix:upper() end
    -- Senão usa o nome limpo
    return name:gsub("%s*%(%d+%)$", ""):gsub("%s*%([EDCBAS]+%)$", "")
end

local function extractRank(mob)
    for _, attr in ipairs(mob:GetAttributes()) do
        local val = mob:GetAttribute(attr)
        if type(val) == "string" and RANK_ORDER[val:upper()] then return val:upper() end
    end
    for _, child in ipairs(mob:GetChildren()) do
        if child:IsA("StringValue") and RANK_ORDER[child.Value:upper()] then
            return child.Value:upper()
        end
    end
    local fromName = mob.Name:match("%(([EDCBAS]+)%)") or mob.Name:match("[%s_%-]([EDCBAS]+)$")
    if fromName and RANK_ORDER[fromName:upper()] then return fromName:upper() end
    return "?"
end

local function extractName(mob)
    -- Se o nome é ID, tenta achar em atributos/filhos
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if hum and hum.DisplayName and hum.DisplayName ~= "" and not looksLikeId(hum.DisplayName) then
        return hum.DisplayName
    end
    for _, child in ipairs(mob:GetChildren()) do
        if child:IsA("StringValue") and not looksLikeId(child.Value) and #child.Value > 0 and #child.Value < 40 then
            local cn = child.Name:lower()
            if cn == "name" or cn == "mobname" or cn:find("displayname") then
                return child.Value
            end
        end
    end
    -- Fallback: nome do model
    return mob.Name
end

local function isAliveMob(instance)
    if not instance or not instance.Parent then return false end
    if not instance:IsA("Model") then return false end
    local humanoid = instance:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if instance == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(instance) then return false end
    return true, humanoid
end

local function scanMobs()
    local t0 = tick()
    local folder = getMobFolder()
    if not folder then
        print("[AutoFarm] Pasta de mobs não encontrada")
        return {}, 0
    end
    print("[AutoFarm] Pasta: " .. folder:GetFullName())
    local mobTypes = {}
    local totalFound = 0
    for _, d in ipairs(folder:GetChildren()) do
        if isAliveMob(d) then
            totalFound = totalFound + 1
            -- 🔑 Agrupa por PREFIXO do ID
            local mobType = extractType(d)
            local rank = extractRank(d)
            local key = mobType .. " [" .. rank .. "]"
            if not mobTypes[key] then
                mobTypes[key] = {
                    name = mobType,
                    rank = rank,
                    key = key,
                    count = 0,
                    examples = {},
                    sampleName = d.Name,  -- guarda 1 nome completo como exemplo
                }
            end
            mobTypes[key].count = mobTypes[key].count + 1
            table.insert(mobTypes[key].examples, d)
        end
    end
    local list = {}
    for _, data in pairs(mobTypes) do table.insert(list, data) end
    table.sort(list, function(a,b)
        local ra = RANK_ORDER[a.rank] or 99
        local rb = RANK_ORDER[b.rank] or 99
        if ra ~= rb then return ra < rb end
        return a.count > b.count
    end)
    State.MobCache = mobTypes
    State.MobList = list
    print("[AutoFarm] Scan: " .. totalFound .. " mobs, " .. #list .. " tipos (" .. math.floor((tick()-t0)*100)/100 .. "s)")
    for _, d in ipairs(list) do
        print("  - [" .. d.rank .. "] " .. d.name .. " (" .. d.count .. "x)  ex: " .. d.sampleName)
    end
    return list, totalFound
end

