-- RANKS CONHECIDOS (ordem crescente)
-- ============================
local RANK_ORDER = { ["E"]=1, ["D"]=2, ["C"]=3, ["B"]=4, ["A"]=5, ["S"]=6, ["SS"]=7, ["SSS"]=8 }

-- Cores por rank
local RANK_COLORS = {
    E   = Color3.fromRGB(180, 180, 180),
    D   = Color3.fromRGB(120, 220, 120),
    C   = Color3.fromRGB(100, 170, 255),
    B   = Color3.fromRGB(180, 110, 255),
