makeButton(inspectPage, "🔬 Inspecionar 1º Mob (mostra 3)", function()
    local folder = getMobFolder()
    if not folder then
        inspectBox.Text = "Pasta de mobs não encontrada!"
        return
    end
    local lines = {}
    table.insert(lines, "Caminho: " .. folder:GetFullName())
    table.insert(lines, "Filhos: " .. #folder:GetChildren())
    table.insert(lines, "")
    local count = 0
    for _, mob in ipairs(folder:GetChildren()) do
        if mob:IsA("Model") and count < 3 then
            count = count + 1
            table.insert(lines, "=== MOB " .. count .. " ===")
            local mob = folder:GetChildren()[count]
            -- pega o primeiro Model que encontrar
            for _, m in ipairs(folder:GetChildren()) do
                if m:IsA("Model") and m.Name ~= lastInspected then
                    mob = m
                    lastInspected = m.Name
                    break
                end
            end
            break
        end
    end
    inspectBox.Text = table.concat(lines, "\n")
    setStatus("Inspeção ✓")
end)

