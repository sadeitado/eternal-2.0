local RANK_ORDER = { ["E"]=1, ["D"]=2, ["C"]=3, ["B"]=4, ["A"]=5, ["S"]=6, ["SS"]=7, ["SSS"]=8 }
local RANK_COLORS = {
    E=Color3.fromRGB(180,180,180), D=Color3.fromRGB(120,220,120),
    C=Color3.fromRGB(100,170,255), B=Color3.fromRGB(180,110,255),
    A=Color3.fromRGB(255,210,60), S=Color3.fromRGB(255,120,50),
    SS=Color3.fromRGB(255,50,150), SSS=Color3.fromRGB(255,0,0),
}

local Config = {
    AutoFarm = false,
    SelectedMob = nil,
    TeleportDistance = 5,
    AttackCooldown = 0.2,
    KillTimeout = 10,       -- segundos tentando matar o mesmo mob
    HpCheckInterval = 1.5,  -- verifica HP a cada X segundos
}

local State = {
    LastAttack = 0,
    MobCache = {},
    MobList = {},
    AutoFarmThread = nil,
    CurrentTarget = nil,
    TargetStartTime = 0,
    TargetStartHp = 0,
    LastHpCheck = 0,
    TargetTeleported = false,  -- ← marca se já teleportou pro alvo atual
    LastTargetHp = 0,          -- ← último HP conhecido, pra saber se está caindo
}

-- ============================
-- UTILS
-- ============================
local function looksLikeId(s)
    if #s < 20 then return false end
    local numeric = 0
    for i = 1, #s do
        local c = s:sub(i,i)
        if c:match("%d") or c == "-" then numeric = numeric + 1 end
    end
    return (numeric / #s) > 0.4
end

local function extractRank(mob)
    for _, attr in ipairs(mob:GetAttributes()) do
        local val = mob:GetAttribute(attr)
        if type(val) == "string" and RANK_ORDER[val:upper()] then return val:upper() end
        if attr:lower():find("rank") or attr:lower():find("tier") then
            if type(val) == "string" then return val:upper() end
        end
    end
    for _, child in ipairs(mob:GetChildren()) do
        local cn = child.Name:lower()
        if (cn:find("rank") or cn:find("tier")) and child:IsA("StringValue") then
            local v = child.Value:upper()
            if RANK_ORDER[v] then return v end
        end
    end
    for _, child in ipairs(mob:GetChildren()) do
        if child:IsA("StringValue") then
            local v = child.Value:upper()
            if RANK_ORDER[v] then return v end
        end
    end
    local fromName = mob.Name:match("%(([EDCBAS]+)%)") or mob.Name:match("[%s_%-]([EDCBAS]+)$")
    if fromName and RANK_ORDER[fromName:upper()] then return fromName:upper() end
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if hum and hum.DisplayName then
        local m = hum.DisplayName:match("%(([EDCBAS]+)%)") or hum.DisplayName:match("[%s_%-]([EDCBAS]+)$")
        if m and RANK_ORDER[m:upper()] then return m:upper() end
    end
    return "?"
end

local function extractName(mob)
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if hum and hum.DisplayName and hum.DisplayName ~= "" and not looksLikeId(hum.DisplayName) then
        local clean = hum.DisplayName:gsub("%s*%([EDCBAS]+%)", ""):gsub("[%s_%-][EDCBAS]+$", "")
        clean = clean:gsub("^%s+", ""):gsub("%s+$", "")
        if #clean > 0 then return clean end
    end
    for _, child in ipairs(mob:GetChildren()) do
        if child:IsA("StringValue") and not looksLikeId(child.Value) then
            local cn = child.Name:lower()
            if cn == "name" or cn == "mobname" or cn:find("displayname") then
                return child.Value
            end
        end
    end
    for _, child in ipairs(mob:GetChildren()) do
        if child:IsA("StringValue") and not looksLikeId(child.Value) and #child.Value < 40 and #child.Value > 2 then
            return child.Value
        end
    end
    local n = mob.Name:gsub("%s*%(%d+%)$", ""):gsub("%s*%([EDCBAS]+%)$", ""):gsub("[%s_%-][EDCBAS]+$", "")
    if looksLikeId(n) then return "Mob-" .. n:sub(1, 6) end
    return n
end

local function isAliveMob(instance)
    if not instance or not instance.Parent then return false end
    if not instance:IsA("Model") then return false end
    local humanoid = instance:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if instance == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(instance) then return false end
    return true, humanoid
end

local function scanMobs()
    local t0 = tick()
    local mobTypes = {}
    local totalFound = 0
    local count = 0
    for _, d in ipairs(Workspace:GetDescendants()) do
        count = count + 1
        if count % 500 == 0 then task.wait() end
        if isAliveMob(d) then
            totalFound = totalFound + 1
            local name = extractName(d)
            local rank = extractRank(d)
            local key = name .. " [" .. rank .. "]"
            if not mobTypes[key] then
                mobTypes[key] = { name = name, rank = rank, key = key, count = 0, examples = {} }
            end
            mobTypes[key].count = mobTypes[key].count + 1
            table.insert(mobTypes[key].examples, d)
        end
    end
    local list = {}
    for _, data in pairs(mobTypes) do table.insert(list, data) end
    table.sort(list, function(a,b)
        local ra = RANK_ORDER[a.rank] or 99
        local rb = RANK_ORDER[b.rank] or 99
        if ra ~= rb then return ra < rb end
        return a.name < b.name
    end)
    State.MobCache = mobTypes
    State.MobList = list
    print("[AutoFarm] Scan: " .. totalFound .. " mobs, " .. #list .. " tipos (" .. math.floor((tick()-t0)*100)/100 .. "s)")
    for _, d in ipairs(list) do
        print("  - [" .. d.rank .. "] " .. d.name .. " (" .. d.count .. "x)")
    end
    return list, totalFound
end

-- ============================
-- ATAQUE
-- ============================
local function attackMob(mob, humanoid)
    if not mob or not mob.PrimaryPart or not humanoid then return end
    if humanoid.Health <= 0 then return end
    local now = tick()
    if now - State.LastAttack < Config.AttackCooldown then return end
    State.LastAttack = now
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
    if tool then pcall(function() tool:Activate() end) end
    pcall(function()
        VirtualUser:Button1Down(Vector2.new(0,0))
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(0,0))
    end)
end

-- ============================
-- AUTO FARM LOOP (v9 - trava real de alvo)
-- ============================
local function autoFarmLoop()
    print("[AutoFarm] Loop iniciado: " .. tostring(Config.SelectedMob))
    while Config.AutoFarm do
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            task.wait(0.5) continue
        end
        local myRoot = char.HumanoidRootPart
        local mobData = State.MobCache[Config.SelectedMob]
        if not mobData then task.wait(0.5) continue end

        -- ============================================
        -- VERIFICAR SE O ALVO ATUAL AINDA É VÁLIDO
        -- ============================================
        local target = State.CurrentTarget
        local needNewTarget = false

        if not target then
            needNewTarget = true
        elseif not target.Parent then
            print("[AutoFarm] Alvo desapareceu")
            needNewTarget = true
        else
            local h = target:FindFirstChildOfClass("Humanoid")
            if not h then
                print("[AutoFarm] Alvo sem Humanoid")
                needNewTarget = true
            elseif h.Health <= 0 then
                print("[AutoFarm] Alvo MORTO! HP = " .. h.Health)
                needNewTarget = true
            else
                -- Verifica se HP está caindo (a cada X segundos)
                local now = tick()
                if now - State.LastHpCheck >= Config.HpCheckInterval then
                    State.LastHpCheck = now
                    if h.Health >= State.LastTargetHp and State.LastTargetHp > 0 then
                        -- HP não caiu desde a última verificação
                        print("[AutoFarm] HP não está caindo (" .. h.Health .. " = " .. State.LastTargetHp .. "). Skipping...")
                        needNewTarget = true
                    end
                    State.LastTargetHp = h.Health
                end

                -- Timeout total
                if now - State.TargetStartTime > Config.KillTimeout then
                    print("[AutoFarm] Timeout de " .. Config.KillTimeout .. "s. Skipping...")
                    needNewTarget = true
                end
            end
        end

        -- ============================================
        -- ESCOLHER NOVO ALVO (se necessário)
        -- ============================================
        if needNewTarget then
            State.CurrentTarget = nil
            State.TargetTeleported = false
            local closestMob, closestDist = nil, math.huge
            for _, mob in ipairs(mobData.examples) do
                if mob.Parent and isAliveMob(mob) and mob.PrimaryPart then
                    local dist = (myRoot.Position - mob.PrimaryPart.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestMob = mob
                    end
                end
            end
            if closestMob then
                State.CurrentTarget = closestMob
                State.TargetStartTime = tick()
                State.LastHpCheck = tick()
                State.LastTargetHp = 0
                target = closestMob
                local h = closestMob:FindFirstChildOfClass("Humanoid")
                print("[AutoFarm] NOVO alvo (HP=" .. (h and h.Health or "?") .. ")")
            else
                task.wait(0.5)
                continue
            end
        end

        -- ============================================
        -- TELEPORTE: só 1x por alvo, ou se o mob se moveu muito
        -- ============================================
        if target and target.Parent and target.PrimaryPart then
            local mobPos = target.PrimaryPart.Position
            local distToMob = (myRoot.Position - mobPos).Magnitude

            -- Teleporta SE:
            --   - ainda não teleportou pra esse alvo, OU
            --   - o mob se afastou muito (> 15 studs)
            if not State.TargetTeleported or distToMob > 15 then
                local dir = (myRoot.Position - mobPos).Unit
                local targetPos = mobPos + dir * Config.TeleportDistance
                targetPos = Vector3.new(targetPos.X, mobPos.Y + 3, targetPos.Z)
                myRoot.CFrame = CFrame.new(targetPos)
                State.TargetTeleported = true
            end

            -- Ataca continuamente
            attackMob(target, target:FindFirstChildOfClass("Humanoid"))
        end

        task.wait(0.1)
    end
    State.CurrentTarget = nil
    State.TargetTeleported = false
    print("[AutoFarm] Loop encerrado")
end

