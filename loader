-- LER NOMES DOS BILLBOARDGUIS
-- ============================
-- Os BillboardGuis ficam em PlayerGui._Main_Folder.Workspace_GUI.<ID>
-- Cada um tem Adornee = HumanoidRootPart do mob
local function getWorkspaceGuiFolder()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local main = pg:FindFirstChild("_Main_Folder")
    if not main then return nil end
    return main:FindFirstChild("Workspace_GUI")
end

-- Extrai nome e rank do BillboardGui e devolve o mob associado
local function parseBillboard(bg)
    if not bg or not bg.Adornee then return nil end
    local main = bg:FindFirstChild("Main")
    if not main then return nil end
    local nameLbl = main:FindFirstChild("Monster_Name")
    if not nameLbl or nameLbl.Text == "" or nameLbl.Text == "Monster Name" then return nil end
    
    local rank = "?"
    local rankFrame = main:FindFirstChild("Monster_Rank")
    if rankFrame then
        for _, sub in ipairs(rankFrame:GetDescendants()) do
            if sub:IsA("TextLabel") and sub.Text ~= "" then
                rank = sub.Text
                break
            end
        end
    end
    
    -- Sobe até encontrar o Model do mob (Adornee é HumanoidRootPart)
    local mob = bg.Adornee
    while mob and not mob:IsA("Model") do
        mob = mob.Parent
    end
    if not mob then return nil end
    
    -- Verifica se está vivo
    local h = mob:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return nil end
    
    return {
        mob = mob,
        humanoid = h,
        name = nameLbl.Text,
        rank = rank:upper(),
    }
end

-- Escaneia todos os BillboardGuis e devolve uma lista agrupada por nome+rank
local function scanMobs()
    local t0 = tick()
    local folder = getWorkspaceGuiFolder()
    if not folder then
        print("[AutoFarm] Workspace_GUI não encontrado")
        return {}, 0
    end
    
    local mobTypes = {}
    local totalFound = 0
    for _, bg in ipairs(folder:GetChildren()) do
        if bg:IsA("BillboardGui") then
            local data = parseBillboard(bg)
            if data then
                totalFound = totalFound + 1
                local key = data.name .. " [" .. data.rank .. "]"
                if not mobTypes[key] then
                    mobTypes[key] = {
                        name = data.name,
                        rank = data.rank,
                        key = key,
                        count = 0,
                        examples = {},  -- lista de {mob, humanoid}
                    }
                end
                mobTypes[key].count = mobTypes[key].count + 1
                table.insert(mobTypes[key].examples, data)
            end
        end
    end
    
    local list = {}
    for _, data in pairs(mobTypes) do table.insert(list, data) end
    table.sort(list, function(a,b)
        local ra = RANK_ORDER[a.rank] or 50
        local rb = RANK_ORDER[b.rank] or 50
        if ra ~= rb then return ra < rb end
        return a.name < b.name
    end)
    
    State.MobCache = mobTypes
    State.MobList = list
    local elapsed = math.floor((tick() - t0) * 100) / 100
    print("[AutoFarm] Scan: " .. totalFound .. " mobs, " .. #list .. " tipos (" .. elapsed .. "s)")
    for _, d in ipairs(list) do
        print("  - [" .. d.rank .. "] " .. d.name .. " (" .. d.count .. "x)")
    end
    return list, totalFound
end

