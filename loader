-- Auto teleportar pro local da quest
task.spawn(function()
    while true do
        task.wait(1)
        if Config.AutoTeleportQuest then
            local folder = getWorkspaceGuiFolder()
            if folder then
                for _, bg in ipairs(folder:GetChildren()) do
                    if bg:IsA("BillboardGui") and bg.Adornee then
                        local main = bg:FindFirstChild("Main")
                        local nameLbl = main and main:FindFirstChild("Monster_Name")
                        if nameLbl and nameLbl.Text ~= "" then
                            -- Se bate com a keyword da quest, teleporta até
                            local kw = Config.QuestMobKeyword
                            if kw == "" or nameLbl.Text:lower():find(kw:lower()) then
                                local mob = bg.Adornee
                                while mob and not mob:IsA("Model") do mob = mob.Parent end
                                if mob and mob.PrimaryPart then
                                    local char = LocalPlayer.Character
                                    if char and char:FindFirstChild("HumanoidRootPart") then
                                        char.HumanoidRootPart.CFrame = mob.PrimaryPart.CFrame + Vector3.new(0, 3, 5)
                                    end
                                end
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end)

