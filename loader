local function makeButton(parent, text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 36)
    b.BackgroundColor3 = THEME.PANEL
    b.Text = text
    b.TextColor3 = THEME.TEXT
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 13
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = THEME.PANEL_HOVER}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = THEME.PANEL}):Play()
    end)
    b.MouseButton1Click:Connect(function()
        task.spawn(function()
            local ok, err = pcall(callback)
            if not ok then warn("[AutoFarm] ERRO: " .. tostring(err)) setStatus("ERRO! Veja F9") end
        end)
    end)
    return b
end

local function makeToggle(parent, text, initial, callback)
    local state = initial
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 36)
    b.BackgroundColor3 = state and THEME.SUCCESS or THEME.PANEL
    b.Text = (state and "✔   " or "✘   ") .. text
    b.TextColor3 = THEME.TEXT
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 13
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    b.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(b, TweenInfo.new(0.2), {
            BackgroundColor3 = state and THEME.SUCCESS or THEME.PANEL
        }):Play()
        b.Text = (state and "✔   " or "✘   ") .. text
        task.spawn(function()
            local ok, err = pcall(callback, state)
            if not ok then warn("[AutoFarm] ERRO: " .. tostring(err)) end
        end)
    end)
    return {
        button = b,
        getState = function() return state end,
        setState = function(v)
            state = v
            TweenService:Create(b, TweenInfo.new(0.2), {
                BackgroundColor3 = state and THEME.SUCCESS or THEME.PANEL
            }):Play()
            b.Text = (state and "✔   " or "✘   ") .. text
        end
    }
end

