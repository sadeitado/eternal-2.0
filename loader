        mobBtn.Size = UDim2.new(1, -16, 0, 30)
        mobBtn.BackgroundColor3 = (Config.SelectedMob == data.key)
            and Color3.fromRGB(0, 120, 200) or Color3.fromRGB(45, 45, 55)
        mobBtn.Text = "  [" .. data.rank .. "]  " .. data.name .. "   (" .. data.count .. "x)"
        mobBtn.TextColor3 = RANK_COLORS[data.rank] or Color3.fromRGB(240, 240, 240)
        mobBtn.Font = Enum.Font.GothamSemibold
        mobBtn.TextSize = 13
        mobBtn.BorderSizePixel = 0
        mobBtn.AutoButtonColor = false
        mobBtn.TextXAlignment = Enum.TextXAlignment.Left
        mobBtn.Parent = dropdownContainer
        Instance.new("UICorner", mobBtn).CornerRadius = UDim.new(0, 6)
        mobBtn.MouseButton1Click:Connect(function()
            Config.SelectedMob = data.key
            State.CurrentTarget = nil
            State.TargetTeleported = false
            setStatus("Alvo: [" .. data.rank .. "] " .. data.name)
            populateDropdown()
        end)
    end
end

